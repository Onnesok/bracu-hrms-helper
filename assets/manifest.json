{
  "manifest_version": 3,
  "name": "BRACU HRMS Helper",
  "short_name": "HRMS Helper",
  "description": "Privacy-conscious local attendance dashboard for BRAC University HRMS, including fixed calendar weeks and carry-forward overtime.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "BRACU HRMS Helper",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "permissions": ["storage", "activeTab"],
  "content_scripts": [{
    "matches": ["https://hrms.bracu.ac.bd/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
